# Environment Configuration for AI News Verification System
# Copy this file to .env and insert your API keys.
# NEVER commit the actual .env file or real API keys to version control.

# Tavily Web Search API Key (Required for Phase 5.1 Real Web Search)
# Obtain a key from https://tavily.com
# When left unset or empty, the application safely operates using the offline MockSearchProvider.
TAVILY_API_KEY=your_api_key_here
